msgstr "Prejsť na stránku nastavení Flash Cache"

#: includes/plugin_functions.php:29
msgid "Settings"
msgstr "Nastavenia"

#: includes/plugin_functions.php:48
msgid "Website"
msgstr "Webová stránka"

#: includes/posts.php:216
msgid "Invalid post."
msgstr "Neplatný článok."

#: includes/posts.php:223
msgid "The post has no cache."
msgstr "Článok nemá cache."

#: includes/posts.php:264
msgid "Clear Entry Cache"
msgstr "Vyprázdniť cache článku"

#: includes/preload.php:283
msgid "Execute Preload"
msgstr "Spustiť predbežné načítanie"

#: includes/preload.php:298
msgid "Preload builds the cache of the public pages, and optionally their categories and tags, following your patterns, so visitors find them already cached."
msgstr "Predbežné načítanie vytvára cache verejných stránok a voliteľne ich kategórií a značiek podľa vašich vzorov, aby ich návštevníci našli už v cache."

#: includes/preload.php:299
msgid "It runs in small batches in the background to keep the server load low."
msgstr "Beží v malých dávkach na pozadí, aby zaťaženie servera zostalo nízke."

#: includes/preload.php:324
msgid "Preload is running now: %1$s - %2$s - %3$s"
msgstr "Predbežné načítanie práve beží: %1$s - %2$s - %3$s"

#: includes/preload.php:327
msgid "Preload is waiting to run."
msgstr "Predbežné načítanie čaká na spustenie."

#: includes/preload.php:331
msgid "Next run: %s"
msgstr "Ďalšie spustenie: %s"

#: includes/preload.php:338
msgid "Enable preload"
msgstr "Zapnúť predbežné načítanie"

#: includes/preload.php:342 includes/preload.php:356 includes/preload.php:385 includes/settings.php:147 includes/settings.php:152 includes/settings.php:485 includes/settings.php:506 includes/settings.php:525 includes/settings.php:540 includes/settings.php:555 includes/settings.php:572
msgid "Off"
msgstr "Vypnuté"

#: includes/preload.php:344 includes/preload.php:358 includes/preload.php:387 includes/settings.php:149 includes/settings.php:154 includes/settings.php:487 includes/settings.php:508 includes/settings.php:527 includes/settings.php:542 includes/settings.php:557 includes/settings.php:574
msgid "On"
msgstr "Zapnuté"

#: includes/preload.php:352
msgid "Include categories and tags"
msgstr "Zahrnúť kategórie a značky"

#: includes/preload.php:363
msgid "Also caches the archive pages of the categories and tags of each preloaded post."
msgstr "Ukladá do cache aj archívne stránky kategórií a značiek každého predbežne načítaného článku."

#: includes/preload.php:367
msgid "Pages per batch"
msgstr "Stránok na dávku"

#: includes/preload.php:370
msgid "How many pages each batch caches. Lower it if the server struggles while preloading."
msgstr "Koľko stránok uloží do cache každá dávka. Znížte hodnotu, ak server pri predbežnom načítaní zápasí."

#: includes/preload.php:374
msgid "Pause between batches"
msgstr "Prestávka medzi dávkami"

#: includes/preload.php:377
msgid "Seconds to wait before the next batch. Raise it if preloading runs into PHP timeouts."
msgstr "Sekundy čakania pred ďalšou dávkou. Zvýšte hodnotu, ak predbežné načítanie narazí na časové limity PHP."

#: includes/preload.php:381
msgid "Stop after one full pass"
msgstr "Zastaviť po jednom úplnom prechode"

#: includes/preload.php:392
msgid "Preload turns itself off once every page has been processed. Leave it off to keep preloading continuously."
msgstr "Predbežné načítanie sa samo vypne, keď sa spracuje každá stránka. Nechajte ho vypnuté, aby predbežné načítanie bežalo nepretržite."

#: includes/preload.php:424 includes/settings.php:701 includes/settings.php:753
msgid "Settings updated"
msgstr "Nastavenia aktualizované"

#: includes/preload.php:433
msgid "Turn on the preload first: it runs only while enabled."
msgstr "Najprv zapnite predbežné načítanie: beží, iba kým je zapnuté."

#: includes/preload.php:438
msgid "The preload has started and runs in the background."
msgstr "Predbežné načítanie sa spustilo a beží na pozadí."

#: includes/preload.php:74
msgid "Flash Cache Preload"
msgstr "Predbežné načítanie Flash Cache"

#: includes/settings.php:158
msgid "Enable cache"
msgstr "Zapnúť cache"

#: includes/settings.php:166
msgid "Turn it off to stop creating new cached pages. Pages already cached are deleted with the button below."
msgstr "Vypnite ho, aby sa prestali vytvárať nové stránky v cache. Stránky, ktoré už sú v cache, sa odstránia tlačidlom nižšie."

#: includes/settings.php:174
msgid "Delete cache"
msgstr "Odstrániť cache"

#: includes/settings.php:177
msgid "Removes every cached page and combined file. Pages are cached again as they are visited or preloaded."
msgstr "Odstráni každú stránku z cache a zlúčený súbor. Stránky sa do cache ukladajú znova, keď ich niekto navštívi alebo sa predbežne načítajú."

#: includes/settings.php:234
msgid "Patterns Settings"
msgstr "Nastavenia vzorov"

#: includes/settings.php:333
msgid "Cache folder"
msgstr "Priečinok cache"

#: includes/settings.php:337
msgid "Where cached pages and combined files are stored, relative to the path shown. It must be a folder of its own, outside the WordPress folders."
msgstr "Kde sa ukladajú stránky z cache a zlúčené súbory, vzhľadom na zobrazenú cestu. Musí to byť samostatný priečinok mimo priečinkov WordPressu."

#: includes/settings.php:341
msgid "HTTPS"
msgstr "HTTPS"

#: includes/settings.php:346
msgid "Serve HTTP and HTTPS"
msgstr "Obsluhovať HTTP aj HTTPS"

#: includes/settings.php:347
msgid "Cached pages are served on both protocols."
msgstr "Stránky z cache sa obsluhujú na oboch protokoloch."

#: includes/settings.php:350
msgid "Redirect HTTP to HTTPS"
msgstr "Presmerovať HTTP na HTTPS"

#: includes/settings.php:351
msgid "Visitors arriving over HTTP are redirected to HTTPS, and browsers are told to keep using HTTPS for the browser cache time (Strict-Transport-Security header)."
msgstr "Návštevníci prichádzajúci cez HTTP sú presmerovaní na HTTPS a prehliadače sú poučené, aby ďalej používali HTTPS počas času cache prehliadača (hlavička Strict-Transport-Security)."

#: includes/settings.php:355
msgid "This admin page is open over HTTP, so cached pages are served as the site is reached. The option to redirect visitors to HTTPS appears here when the admin is opened over HTTPS."
msgstr "Táto administračná stránka je otvorená cez HTTP, takže stránky z cache sa obsluhujú tak, ako sa k webovej stránke pristupuje. Možnosť presmerovať návštevníkov na HTTPS sa tu zobrazí, keď sa administrácia otvorí cez HTTPS."

#: includes/settings.php:361
msgid "Browser cache time"
msgstr "Čas cache prehliadača"

#: includes/settings.php:364
msgid "Seconds a browser may keep a cached page before asking for it again, sent in the Cache-Control header. 86400 is one day."
msgstr "Sekundy, počas ktorých môže prehliadač držať stránku z cache, kým o ňu znova požiada; odosielajú sa v hlavičke Cache-Control. 86400 je jeden deň."

#: includes/settings.php:369
msgid "Skip visitors with cookies"
msgstr "Preskočiť návštevníkov s cookies"

#: includes/settings.php:374
msgid "Visitors who send a cookie whose name contains one of these texts always get the live page. Logged-in users, commenters and visitors of password-protected posts are listed by default."
msgstr "Návštevníci, ktorí odošlú cookie s názvom obsahujúcim jeden z týchto textov, vždy dostanú živú stránku. Prihlásení používatelia, komentujúci a návštevníci článkov chránených heslom sú v zozname predvolene."

#: includes/settings.php:386
msgid "Add"
msgstr "Pridať"

#: includes/settings.php:391
msgid "Lock"
msgstr "Zámok"

#: includes/settings.php:393
msgid "Files (Recommended)"
msgstr "Súbory (odporúčané)"

#: includes/settings.php:394
msgid "A lock file per page keeps two visitors from building the same page at the same time."
msgstr "Súbor zámku na každú stránku bráni tomu, aby dvaja návštevníci stavali tú istú stránku naraz."

#: includes/settings.php:396
msgid "Database"
msgstr "Databáza"

#: includes/settings.php:397
msgid "A MySQL lock does the same. Useful when several servers share the database but not the disk."
msgstr "Zámok MySQL robí to isté. Užitočné, keď viacero serverov zdieľa databázu, ale nie disk."

#: includes/settings.php:405
msgid "Cache creation"
msgstr "Vytváranie cache"

#: includes/settings.php:407
msgid "Capture the visited page (Recommended)"
msgstr "Zachytiť navštívenú stránku (odporúčané)"

#: includes/settings.php:407
msgid "The page a visitor receives is stored as it is sent; later refreshes request the page again in the background."
msgstr "Stránka, ktorú návštevník dostane, sa uloží tak, ako sa odošle; neskoršie obnovenia požiadajú o stránku znova na pozadí."

#: includes/settings.php:409
msgid "Request the page separately"
msgstr "Požiadať o stránku samostatne"

#: includes/settings.php:410
msgid "Every page is fetched with its own request. Slower; use it when another plugin conflicts with output buffering."
msgstr "Každá stránka sa načíta vlastnou požiadavkou. Pomalšie; použite, keď iný plugin kolíduje s ukladaním výstupu do vyrovnávacej pamäte."

#: includes/settings.php:415
msgid "Refresh expired pages"
msgstr "Obnovovať stránky s vypršanou platnosťou"

#: includes/settings.php:417
msgid "On visits (Recommended)"
msgstr "Pri návštevách (odporúčané)"

#: includes/settings.php:418
msgid "A visit to a page whose “Refresh after” time has passed asks the server to rebuild it in the background. Fresh pages make no extra request."
msgstr "Návšteva stránky, ktorej čas „Obnoviť po“ uplynul, požiada server, aby ju prebudoval na pozadí. Čerstvé stránky nevykonávajú žiadnu ďalšiu požiadavku."

#: includes/settings.php:420
msgid "From the preload only"
msgstr "Iba z predbežného načítania"

#: includes/settings.php:421
msgid "Cached pages carry no refresh script. Expired pages are rebuilt by the Preload process, so keep it enabled."
msgstr "Stránky z cache nenesú skript na obnovenie. Stránky s vypršanou platnosťou prebudováva proces predbežného načítania, takže ho nechajte zapnutý."

#: includes/settings.php:428
msgid "This site has %s published post, so its cache is refreshed gradually."
msgid_plural "This site has %s published posts, so its cache is refreshed gradually."
msgstr[0] "Táto webová stránka má %s publikovaný článok, takže jej cache sa obnovuje postupne."
msgstr[1] "Táto webová stránka má %s publikované články, takže jej cache sa obnovuje postupne."
msgstr[2] "Táto webová stránka má %s publikovaných článkov, takže jej cache sa obnovuje postupne."

#: includes/settings.php:429
msgid "This site has %s published post, so its whole cache is deleted."
msgid_plural "This site has %s published posts, so its whole cache is deleted."
msgstr[0] "Táto webová stránka má %s publikovaný článok, takže sa odstráni celá jej cache."
msgstr[1] "Táto webová stránka má %s publikované články, takže sa odstráni celá jej cache."
msgstr[2] "Táto webová stránka má %s publikovaných článkov, takže sa odstráni celá jej cache."

#: includes/settings.php:431
msgid "After design changes"
msgstr "Po zmenách dizajnu"

#: includes/settings.php:433
msgid "Automatic (Recommended)"
msgstr "Automaticky (odporúčané)"

#: includes/settings.php:434
msgid "Deletes the whole cache on sites with up to %s published posts and refreshes it gradually on larger ones."
msgstr "Odstráni celú cache na webových stránkach s najviac %s publikovanými článkami a na väčších ju obnovuje postupne."

#: includes/settings.php:437
msgid "Delete the whole cache"
msgstr "Odstrániť celú cache"

#: includes/settings.php:438
msgid "Pages are cached again as they are visited or preloaded. Best for small and medium sites."
msgstr "Stránky sa do cache ukladajú znova, keď ich niekto navštívi alebo sa predbežne načítajú. Najlepšie pre malé a stredné webové stránky."

#: includes/settings.php:440
msgid "Refresh gradually"
msgstr "Obnovovať postupne"

#: includes/settings.php:441
msgid "Visitors keep getting the current pages while they are replaced a few at a time, by the preload or on their next visit. No empty cache, no load spike. Best for large sites."
msgstr "Návštevníci naďalej dostávajú aktuálne stránky, kým sa nahrádzajú po niekoľkých, predbežným načítaním alebo pri ich ďalšej návšteve. Žiadna prázdna cache, žiadna špička zaťaženia. Najlepšie pre veľké webové stránky."

#: includes/settings.php:443
msgid "Do nothing"
msgstr "Nerobiť nič"

#: includes/settings.php:444
msgid "Delete the cache yourself after each change."
msgstr "Po každej zmene odstráňte cache sami."

#: includes/settings.php:446
msgid "Applies when widgets, menus, Customizer settings, block theme templates or synced patterns are saved. Switching themes always deletes the whole cache."
msgstr "Platí pri uložení widgetov, ponúk, nastavení Prispôsobenia, šablón blokových tém alebo synchronizovaných vzorov. Prepnutie témy vždy odstráni celú cache."

#: includes/settings.php:451
msgid "Widgets/blocks without cache"
msgstr "Widgety/bloky bez cache"

#: includes/settings.php:454
msgid "Widget cache disabling is available in the Pro version."
msgstr "Vypnutie cache widgetov je dostupné vo verzii Pro."

#: includes/settings.php:464
msgid "Building each widget once for the whole site, and updating it inside the cached pages when it is saved, is available in the Pro version."
msgstr "Vytvorenie každého widgetu raz pre celú webovú stránku a jeho aktualizácia v stránkach z cache pri uložení je dostupné vo verzii Pro."

#: includes/settings.php:481
msgid "Optimize styles"
msgstr "Optimalizovať štýly"

#: includes/settings.php:492
msgid "Joins the stylesheets of each page into shared files, in their order and with their media, so pages load fewer files."
msgstr "Spojí štýlové tabuľky každej stránky do zdieľaných súborov, v ich poradí a s ich médiami, aby stránky načítali menej súborov."

#: includes/settings.php:494
msgid "Minify styles"
msgstr "Minifikovať štýly"

#: includes/settings.php:494
msgid "Removes spaces and comments from the combined stylesheets, so they weigh less."
msgstr "Odstráni medzery a komentáre zo zlúčených štýlových tabuliek, aby vážili menej."

#: includes/settings.php:496
msgid "Cache Google fonts"
msgstr "Ukladať Google Fonts do cache"

#: includes/settings.php:496
msgid "Keeps a copy of Google Fonts on your server, so pages make fewer requests to other sites."
msgstr "Uchováva kópiu Google Fonts na vašom serveri, aby stránky vykonávali menej požiadaviek na iné webové stránky."

#: includes/settings.php:50
msgid "Counting…"
msgstr "Počíta sa…"

#: includes/settings.php:502
msgid "Optimize scripts"
msgstr "Optimalizovať skripty"

#: includes/settings.php:513
msgid "Joins consecutive scripts into shared files, keeping their order and their place in the page, so pages load fewer files."
msgstr "Spojí po sebe idúce skripty do zdieľaných súborov, zachová ich poradie a miesto na stránke, aby stránky načítali menej súborov."

#: includes/settings.php:517
msgid "If something stops working with optimized scripts, leave the scripts involved in place:"
msgstr "Ak niečo prestane fungovať s optimalizovanými skriptami, nechajte príslušné skripty na svojom mieste:"

#: includes/settings.php:521
msgid "Leave inline scripts in place"
msgstr "Nechať vložené skripty na mieste"

#: includes/settings.php:532
msgid "Scripts written inside the page stay where they are."
msgstr "Skripty napísané priamo v stránke zostanú tam, kde sú."

#: includes/settings.php:536
msgid "Leave theme scripts in place"
msgstr "Nechať skripty témy na mieste"

#: includes/settings.php:547
msgid "Scripts of the active theme, and of its parent theme, stay as separate files."
msgstr "Skripty aktívnej témy a jej nadradenej témy zostanú ako samostatné súbory."

#: includes/settings.php:551
msgid "Leave plugin scripts in place"
msgstr "Nechať skripty pluginov na mieste"

#: includes/settings.php:562
msgid "Scripts of plugins stay as separate files."
msgstr "Skripty pluginov zostanú ako samostatné súbory."

#: includes/settings.php:563
msgid "Choosing each plugin individually is available in the Pro version."
msgstr "Výber každého pluginu samostatne je dostupný vo verzii Pro."

#: includes/settings.php:563
msgid "Avoid optimizing JavaScript by file"
msgstr "Nevyhnúť sa optimalizácii JavaScriptu podľa súboru"

#: includes/settings.php:563
msgid "Leaves specific script files in place, by name or path."
msgstr "Necháva určité súbory skriptov na mieste podľa názvu alebo cesty."

#: includes/settings.php:568
msgid "Scripts from other domains"
msgstr "Skripty z iných domén"

#: includes/settings.php:579
msgid "Off (recommended): analytics, ads, social and other third-party scripts keep loading from their own servers, where they stay up to date. On: they are copied into the combined files."
msgstr "Vypnuté (odporúčané): analytické, reklamné, sociálne a iné skripty tretích strán sa naďalej načítavajú z vlastných serverov, kde zostávajú aktuálne. Zapnuté: kopírujú sa do zlúčených súborov."

#: includes/settings.php:586
msgid "Minify scripts"
msgstr "Minifikovať skripty"

#: includes/settings.php:586
msgid "Removes spaces and comments from the combined scripts, so they weigh less."
msgstr "Odstráni medzery a komentáre zo zlúčených skriptov, aby vážili menej."

#: includes/settings.php:600 includes/settings.php:629
msgid "Check again"
msgstr "Skontrolovať znova"

#: includes/settings.php:601 includes/settings.php:620
msgid "Server rules"
msgstr "Pravidlá servera"

#: includes/settings.php:603
msgid "nginx is serving cached pages with the current rules."
msgstr "nginx obsluhuje stránky z cache s aktuálnymi pravidlami."

#: includes/settings.php:604
msgid "After changing settings, reload nginx so it reads the updated rules."
msgstr "Po zmene nastavení znova načítajte nginx, aby prečítal aktualizované pravidlá."

#: includes/settings.php:608
msgid "nginx is running an older version of the Flash Cache rules. Reload nginx to apply the current settings."
msgstr "nginx spúšťa staršiu verziu pravidiel Flash Cache. Znova načítajte nginx, aby sa použili aktuálne nastavenia."

#: includes/settings.php:611
msgid "The site could not be reached to check whether nginx reads the Flash Cache rules."
msgstr "Nepodarilo sa pristúpiť k webovej stránke, aby sa overilo, či nginx číta pravidlá Flash Cache."

#: includes/settings.php:611
msgid "nginx is not reading the Flash Cache rules yet: pages are cached but still built by PHP."
msgstr "nginx ešte nečíta pravidlá Flash Cache: stránky sú v cache, ale stále ich stavia PHP."

#: includes/settings.php:612
msgid "Add this line inside the server { } block of your site, before its location rules, and reload nginx:"
msgstr "Pridajte tento riadok do bloku server { } vašej webovej stránky, pred jej pravidlá location, a znova načítajte nginx:"

#: includes/settings.php:614 includes/settings.php:645
msgid "Copied"
msgstr "Skopírované"

#: includes/settings.php:614 includes/settings.php:645
msgid "Copy"
msgstr "Kopírovať"

#: includes/settings.php:615
msgid "Flash Cache keeps that file up to date; reload nginx after changing settings."
msgstr "Flash Cache udržiava tento súbor aktuálny; po zmene nastavení znova načítajte nginx."

#: includes/settings.php:624
msgid "OpenLiteSpeed is serving cached pages with the current rules."
msgstr "OpenLiteSpeed obsluhuje stránky z cache s aktuálnymi pravidlami."

#: includes/settings.php:625
msgid "OpenLiteSpeed reads .htaccess only when it restarts: restart it after changing settings."
msgstr "OpenLiteSpeed číta .htaccess iba pri reštarte: po zmene nastavení ho reštartujte."

#: includes/settings.php:627
msgid "The site could not be reached to check whether OpenLiteSpeed runs the current Flash Cache rules."
msgstr "Nepodarilo sa pristúpiť k webovej stránke, aby sa overilo, či OpenLiteSpeed spúšťa aktuálne pravidlá Flash Cache."

#: includes/settings.php:627
msgid "OpenLiteSpeed is not running the current Flash Cache rules yet. Restart it to apply them: Graceful Restart in WebAdmin, or the LiteSpeed restart of your hosting panel."
msgstr "OpenLiteSpeed ešte nespúšťa aktuálne pravidlá Flash Cache. Reštartujte ho, aby sa použili: Graceful Restart vo WebAdmin alebo reštart LiteSpeed z panela vášho hostingu."

#: includes/settings.php:628
msgid "Required: until then, pages follow the rules OpenLiteSpeed loaded last, or are built by PHP."
msgstr "Povinné: dovtedy stránky sledujú pravidlá, ktoré OpenLiteSpeed načítal naposledy, alebo ich stavia PHP."

#: includes/settings.php:637
msgid "Optional: browser cache headers"
msgstr "Voliteľné: hlavičky cache prehliadača"

#: includes/settings.php:639
msgid "Cached pages already work without this. OpenLiteSpeed ignores the headers in .htaccess, so browsers get no caching instructions for them. Add this context to the virtual host of your site to let browsers keep each page for %s, so return visits load faster, then restart OpenLiteSpeed:"
msgstr "Stránky z cache už fungujú aj bez toho. OpenLiteSpeed ignoruje hlavičky v .htaccess, takže prehliadače pre ne nedostávajú pokyny na cache. Pridajte tento kontext do virtuálneho hostiteľa vašej webovej stránky, aby prehliadače držali každú stránku %s a opakované návštevy sa načítali rýchlejšie, a potom reštartujte OpenLiteSpeed:"

#: includes/settings.php:643
msgid "For \"Redirect HTTP to HTTPS\", also add %s to the Header Operations of the / context."
msgstr "Pre „Presmerovať HTTP na HTTPS“ pridajte aj %s do operácií hlavičky kontextu /."

#: includes/settings.php:646
msgid "Dismiss until the next update"
msgstr "Skryť do ďalšej aktualizácie"

#: includes/settings.php:66 includes/settings.php:67
msgid "Flash Cache"
msgstr "Flash Cache"

#: includes/settings.php:669
msgid "A difference between the rules in your <strong>nginx.conf</strong> file and the Flash Cache rules has been found. This could be simple whitespace differences, but you should compare the rules in the file with those below as soon as possible. Click the &#8217;Update Rules&#8217; button to update the rules."
msgstr "Bol nájdený rozdiel medzi pravidlami vo vašom súbore <strong>nginx.conf</strong> a pravidlami Flash Cache. Môžu to byť jednoduché rozdiely v medzerách, ale mali by ste čo najskôr porovnať pravidlá v súbore s tými nižšie. Kliknutím na tlačidlo &#8217;Aktualizovať pravidlá&#8217; pravidlá aktualizujete."

#: includes/settings.php:671
msgid "A difference between the rules in your <strong>.htaccess</strong> file and the plugin rewrite rules has been found. This could be simple whitespace differences, but you should compare the rules in the file with those below as soon as possible. Click the &#8217;Update Rules&#8217; button to update the rules."
msgstr "Bol nájdený rozdiel medzi pravidlami vo vašom súbore <strong>.htaccess</strong> a pravidlami prepisovania pluginu. Môžu to byť jednoduché rozdiely v medzerách, ale mali by ste čo najskôr porovnať pravidlá v súbore s tými nižšie. Kliknutím na tlačidlo &#8217;Aktualizovať pravidlá&#8217; pravidlá aktualizujete."

#: includes/settings.php:681
msgid "Update Rules"
msgstr "Aktualizovať pravidlá"

#: includes/settings.php:727
msgid "The cache folder must be a folder inside the site, such as flash_cache/, outside the WordPress folders. The current folder was kept."
msgstr "Priečinok cache musí byť priečinok vo vnútri webovej stránky, napríklad flash_cache/, mimo priečinkov WordPressu. Aktuálny priečinok bol zachovaný."

#: includes/settings.php:765
msgid "Web server rules updated"
msgstr "Pravidlá webového servera boli aktualizované"

#: includes/settings.php:772
msgid "The cache files have been deleted."
msgstr "Súbory cache boli odstránené."

