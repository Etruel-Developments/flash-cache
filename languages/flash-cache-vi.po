#: flash_cache.php:149
msgid "Flash Cache works on single WordPress sites and cannot be activated on a Multisite network."
msgstr "Flash Cache hoạt động trên các trang web WordPress đơn lẻ và không thể kích hoạt trên mạng multisite."

#: flash_cache.php:149
msgid "Plugin not activated"
msgstr "Plugin chưa được kích hoạt"

#: includes/about.php:103
msgid "Measured, not promised"
msgstr "Đã đo lường, không phải lời hứa"

#: includes/about.php:104
msgid "Home page on our Apache test site (WordPress 7.1, PHP 7.4), warm cache, compared with the same site without any cache plugin."
msgstr "Trang chủ của trang web thử nghiệm Apache của chúng tôi (WordPress 7.1, PHP 7.4), bộ nhớ đệm đã làm nóng, so với chính trang web đó khi không có plugin bộ nhớ đệm nào."

#: includes/about.php:106 includes/about.php:133
