msgid "Could not reach flashcache.net. Try again in a moment."
msgstr "Δεν ήταν δυνατή η σύνδεση με το flashcache.net. Δοκιμάστε ξανά σε λίγο."

#: includes/about.php:71
msgid "Thank you!"
msgstr "Ευχαριστούμε!"

#: includes/about.php:77 includes/functions.php:137 includes/patterns.php:849 includes/votes.php:91
msgid "You are not allowed to do this."
msgstr "Δεν επιτρέπεται να το κάνετε αυτό."

#: includes/about.php:95
msgid "The super accelerator for WordPress"
msgstr "Ο υπερ-επιταχυντής για το WordPress"

#: includes/about.php:96
msgid "Every page of your site becomes a static file that your web server sends straight to the visitor — no PHP, no WordPress, no waiting."
msgstr "Κάθε σελίδα του ιστότοπού σας γίνεται ένα στατικό αρχείο που ο διακομιστής ιστού σας στέλνει κατευθείαν στον επισκέπτη, χωρίς PHP, χωρίς WordPress, χωρίς αναμονή."

#: includes/about.php:97
msgid "★ Rate on WordPress.org"
msgstr "★ Αξιολογήστε στο WordPress.org"

#: includes/about.php:97 includes/about.php:216
msgid "Documentation"
msgstr "Τεκμηρίωση"

#: includes/about.php:97 includes/about.php:216 includes/plugin_functions.php:49
msgid "Support"
