#: flash_cache.php:149
msgid "Flash Cache works on single WordPress sites and cannot be activated on a Multisite network."
msgstr "Flash Cache работает на отдельных сайтах WordPress и не может быть активирован в сети Multisite."

#: flash_cache.php:149
msgid "Plugin not activated"
msgstr "Плагин не активирован"

