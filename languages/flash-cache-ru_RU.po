#: includes/patterns.php:332
msgid "Pattern Data"
msgstr "Данные паттерна"

#: includes/patterns.php:350
msgid "This is the fallback pattern: it is always last in the list, so it caches every page that no other pattern takes."
msgstr "Это резервный паттерн: он всегда последний в списке, поэтому кеширует каждую страницу, которую не взял другой паттерн."

#: includes/patterns.php:355
msgid "Page types"
msgstr "Типы страниц"

#: includes/patterns.php:359
msgid "The kinds of pages this pattern applies to; unchecked types are left to the other patterns. Each page follows the first pattern in the Patterns list that applies to it, and the Default pattern is always last."
msgstr "Виды страниц, к которым применяется этот паттерн; неотмеченные типы остаются другим паттернам. Каждая страница следует первому подходящему паттерну из списка паттернов, а паттерн по умолчанию всегда последний."

#: includes/patterns.php:361
msgid "Single posts and pages"
msgstr "Отдельные записи и страницы"

#: includes/patterns.php:380
msgid "With no post type selected, every post type is included."
msgstr "Если тип записи не выбран, включаются все типы записей."

#: includes/patterns.php:382
msgid "Cache the post when it is published or updated"
msgstr "Кешировать запись при её публикации или обновлении"

#: includes/patterns.php:384
msgid "Refresh the home page when a post is published or updated"
msgstr "Обновлять главную страницу при публикации или обновлении записи"

#: includes/patterns.php:386
msgid "Refresh the first page of its categories and tags"
msgstr "Обновлять первую страницу её рубрик и меток"

#: includes/patterns.php:388
msgid "Refresh the post when a comment is approved"
msgstr "Обновлять запись при одобрении комментария"

#: includes/patterns.php:394
msgid "Front page (is_front_page)"
msgstr "Главная страница (is_front_page)"

#: includes/patterns.php:397
msgid "Posts page (is_home)"
msgstr "Страница записей (is_home)"

#: includes/patterns.php:398
msgid "The list of latest posts when the front page is a static page."
msgstr "Список последних записей, когда главная страница является статической."

#: includes/patterns.php:401
msgid "Categories (is_category)"
msgstr "Рубрики (is_category)"

#: includes/patterns.php:404
msgid "Tags (is_tag)"
msgstr "Метки (is_tag)"

#: includes/patterns.php:407
msgid "Author pages (is_author)"
msgstr "Страницы авторов (is_author)"

#: includes/patterns.php:410
msgid "Other archives (is_archive)"
msgstr "Прочие архивы (is_archive)"

#: includes/patterns.php:411
msgid "Date archives, custom taxonomies and post type archives."
msgstr "Архивы по датам, произвольные таксономии и архивы типов записей."

#: includes/patterns.php:414
msgid "Feeds (is_feed)"
msgstr "Фиды (is_feed)"

#: includes/patterns.php:417
msgid "Search results (is_search)"
msgstr "Результаты поиска (is_search)"

#: includes/patterns.php:426
msgid "URL must contain"
msgstr "URL должен содержать"

#: includes/patterns.php:429
msgid "Only pages whose URL contains every one of these texts use this pattern."
msgstr "Этот паттерн используют только страницы, URL которых содержит все эти тексты."

#: includes/patterns.php:430 includes/patterns.php:438
msgid "One text per line."
msgstr "Один текст в строке."

#: includes/patterns.php:434
msgid "URL should not contain"
msgstr "URL не должен содержать"

#: includes/patterns.php:437
msgid "Pages whose URL contains any of these texts skip this pattern, for example “login”."
msgstr "Страницы, URL которых содержит любой из этих текстов, пропускают этот паттерн, например «login»."

#: includes/patterns.php:445
msgid "Cache type"
msgstr "Тип кеша"

#: includes/patterns.php:451
msgid "Static HTML (fastest)"
msgstr "Статический HTML (самый быстрый)"

#: includes/patterns.php:452
msgid "The web server delivers the stored page without running PHP. Pages with a query string are not served from this cache."
msgstr "Веб-сервер отдаёт сохранённую страницу без запуска PHP. Страницы со строкой запроса из этого кеша не отдаются."

#: includes/patterns.php:459
msgid "PHP (pages with query strings)"
msgstr "PHP (страницы со строками запроса)"

#: includes/patterns.php:460
msgid "A small PHP file keeps one copy per query string, which suits searches and feeds. A bit slower than static HTML; form submissions always reach WordPress."
msgstr "Небольшой файл PHP хранит по одной копии на каждую строку запроса, что подходит для поиска и лент. Немного медленнее статического HTML; отправка форм всегда доходит до WordPress."

#: includes/patterns.php:467 includes/patterns.php:766
msgid "Don't cache"
msgstr "Не кешировать"

#: includes/patterns.php:468
msgid "The pages this pattern applies to are always served live by WordPress. Place it above the patterns it must override."
msgstr "Страницы, к которым применяется этот паттерн, всегда отдаются WordPress вживую. Поместите его выше паттернов, которые он должен переопределить."

#: includes/patterns.php:477
msgid "Refresh after"
msgstr "Обновлять через"

#: includes/patterns.php:480
msgid "Seconds a cached page is served before a visit asks for a fresh copy. 86400 is one day."
msgstr "Секунды, в течение которых страница из кеша отдаётся, пока посещение не запросит свежую копию. 86400 — это сутки."

#: includes/patterns.php:484
msgid "Preload refresh after"
msgstr "Обновление предзагрузкой через"

#: includes/patterns.php:487
msgid "Seconds before the preload rebuilds a cached page. With “Refresh expired pages: from the preload only”, the preload uses “Refresh after” instead."
msgstr "Секунды до того, как предзагрузка пересоберёт страницу из кеша. При настройке «Обновлять просроченные страницы: только предзагрузкой» предзагрузка использует «Обновлять через»."

#: includes/patterns.php:747
msgid "Order"
msgstr "Порядок"

#: includes/patterns.php:749
msgid "Applies to"
msgstr "Применяется к"

#: includes/patterns.php:750
