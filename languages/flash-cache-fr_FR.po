#: includes/preload.php:283
msgid "Execute Preload"
msgstr "Exécuter le préchargement"

#: includes/preload.php:298
msgid "Preload builds the cache of the public pages, and optionally their categories and tags, following your patterns, so visitors find them already cached."
msgstr "Le préchargement construit le cache des pages publiques, et éventuellement de leurs catégories et étiquettes, selon vos compositions, pour que les visiteurs les trouvent déjà en cache."

#: includes/preload.php:299
msgid "It runs in small batches in the background to keep the server load low."
msgstr "Il s’exécute par petits lots en arrière-plan pour limiter la charge du serveur."

#: includes/preload.php:324
msgid "Preload is running now: %1$s - %2$s - %3$s"
msgstr "Préchargement en cours : %1$s - %2$s - %3$s"

#: includes/preload.php:327
msgid "Preload is waiting to run."
msgstr "Le préchargement attend son exécution."

#: includes/preload.php:331
msgid "Next run: %s"
msgstr "Prochaine exécution : %s"

#: includes/preload.php:338
msgid "Enable preload"
msgstr "Activer le préchargement"

#: includes/preload.php:342 includes/preload.php:356 includes/preload.php:385 includes/settings.php:147 includes/settings.php:152 includes/settings.php:485 includes/settings.php:506 includes/settings.php:525 includes/settings.php:540 includes/settings.php:555 includes/settings.php:572
