msgstr "Páginas de autor (is_author)"

#: includes/patterns.php:410
msgid "Other archives (is_archive)"
msgstr "Otros archivos (is_archive)"

#: includes/patterns.php:411
msgid "Date archives, custom taxonomies and post type archives."
msgstr "Archivos por fecha, taxonomías personalizadas y archivos de tipos de contenido."

#: includes/patterns.php:414
msgid "Feeds (is_feed)"
msgstr "Feeds (is_feed)"

#: includes/patterns.php:417
msgid "Search results (is_search)"
msgstr "Resultados de búsqueda (is_search)"

#: includes/patterns.php:426
msgid "URL must contain"
msgstr "La URL debe contener"

#: includes/patterns.php:429
msgid "Only pages whose URL contains every one of these texts use this pattern."
msgstr "Solo las páginas cuya URL contiene todos estos textos usan este patrón."

#: includes/patterns.php:430 includes/patterns.php:438
msgid "One text per line."
msgstr "Un texto por línea."

#: includes/patterns.php:434
msgid "URL should not contain"
msgstr "La URL no debe contener"

#: includes/patterns.php:437
msgid "Pages whose URL contains any of these texts skip this pattern, for example “login”."
msgstr "Las páginas cuya URL contiene cualquiera de estos textos omiten este patrón, por ejemplo «login»."

#: includes/patterns.php:445
msgid "Cache type"
msgstr "Tipo de caché"

#: includes/patterns.php:451
msgid "Static HTML (fastest)"
msgstr "HTML estático (el más rápido)"

#: includes/patterns.php:452
msgid "The web server delivers the stored page without running PHP. Pages with a query string are not served from this cache."
msgstr "El servidor web entrega la página guardada sin ejecutar PHP. Las páginas con cadena de consulta no se sirven desde esta caché."

#: includes/patterns.php:459
msgid "PHP (pages with query strings)"
msgstr "PHP (páginas con cadenas de consulta)"

#: includes/patterns.php:460
msgid "A small PHP file keeps one copy per query string, which suits searches and feeds. A bit slower than static HTML; form submissions always reach WordPress."
msgstr "Un pequeño archivo PHP guarda una copia por cada cadena de consulta, algo adecuado para búsquedas y feeds. Es algo más lento que el HTML estático; los envíos de formularios siempre llegan a WordPress."

#: includes/patterns.php:467 includes/patterns.php:766
msgid "Don't cache"
msgstr "No guardar en caché"

#: includes/patterns.php:468
msgid "The pages this pattern applies to are always served live by WordPress. Place it above the patterns it must override."
msgstr "Las páginas a las que se aplica este patrón las sirve siempre WordPress en vivo. Colócalo por encima de los patrones que debe anular."

#: includes/patterns.php:477
msgid "Refresh after"
msgstr "Actualizar tras"

#: includes/patterns.php:480
msgid "Seconds a cached page is served before a visit asks for a fresh copy. 86400 is one day."
msgstr "Segundos durante los que se sirve una página en caché antes de que una visita pida una copia nueva. 86400 es un día."

#: includes/patterns.php:484
msgid "Preload refresh after"
msgstr "Actualizar en la precarga tras"

#: includes/patterns.php:487
msgid "Seconds before the preload rebuilds a cached page. With “Refresh expired pages: from the preload only”, the preload uses “Refresh after” instead."
msgstr "Segundos antes de que la precarga reconstruya una página en caché. Con «Actualizar páginas caducadas: solo desde la precarga», la precarga usa «Actualizar tras»."

#: includes/patterns.php:747
msgid "Order"
msgstr "Orden"

#: includes/patterns.php:749
