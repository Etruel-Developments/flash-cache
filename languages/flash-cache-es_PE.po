msgstr "Arrastra para cambiar el orden"

#: includes/patterns.php:762
msgid "Fallback: always last, it caches every page no other pattern takes."
msgstr "Respaldo: siempre va al final y guarda en caché todas las páginas que no toma ningún otro patrón."

