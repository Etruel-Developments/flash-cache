msgid "Front page (is_front_page)"
msgstr "Startseite (is_front_page)"

#: includes/patterns.php:397
msgid "Posts page (is_home)"
msgstr "Beitragsseite (is_home)"

#: includes/patterns.php:398
msgid "The list of latest posts when the front page is a static page."
msgstr "Die Liste der neuesten Beiträge, wenn die Startseite eine statische Seite ist."

#: includes/patterns.php:401
msgid "Categories (is_category)"
msgstr "Kategorien (is_category)"

#: includes/patterns.php:404
msgid "Tags (is_tag)"
msgstr "Schlagwörter (is_tag)"

#: includes/patterns.php:407
msgid "Author pages (is_author)"
msgstr "Autorenseiten (is_author)"

#: includes/patterns.php:410
msgid "Other archives (is_archive)"
msgstr "Andere Archive (is_archive)"

#: includes/patterns.php:411
msgid "Date archives, custom taxonomies and post type archives."
msgstr "Datumsarchive, individuelle Taxonomien und Archive von Inhaltstypen."

#: includes/patterns.php:414
msgid "Feeds (is_feed)"
msgstr "Feeds (is_feed)"

#: includes/patterns.php:417
msgid "Search results (is_search)"
msgstr "Suchergebnisse (is_search)"

#: includes/patterns.php:426
msgid "URL must contain"
msgstr "URL muss enthalten"

#: includes/patterns.php:429
msgid "Only pages whose URL contains every one of these texts use this pattern."
msgstr "Nur Seiten, deren URL alle diese Texte enthält, verwenden diese Vorlage."

#: includes/patterns.php:430 includes/patterns.php:438
msgid "One text per line."
msgstr "Ein Text pro Zeile."

#: includes/patterns.php:434
msgid "URL should not contain"
msgstr "URL darf nicht enthalten"

#: includes/patterns.php:437
msgid "Pages whose URL contains any of these texts skip this pattern, for example “login”."
msgstr "Seiten, deren URL einen dieser Texte enthält, überspringen diese Vorlage, zum Beispiel „login“."

#: includes/patterns.php:445
msgid "Cache type"
msgstr "Cache-Typ"

#: includes/patterns.php:451
msgid "Static HTML (fastest)"
msgstr "Statisches HTML (am schnellsten)"

#: includes/patterns.php:452
msgid "The web server delivers the stored page without running PHP. Pages with a query string are not served from this cache."
msgstr "Der Webserver liefert die gespeicherte Seite ohne PHP aus. Seiten mit Abfragezeichenfolge werden nicht aus diesem Cache ausgeliefert."

#: includes/patterns.php:459
msgid "PHP (pages with query strings)"
msgstr "PHP (Seiten mit Abfragezeichenfolgen)"

#: includes/patterns.php:460
msgid "A small PHP file keeps one copy per query string, which suits searches and feeds. A bit slower than static HTML; form submissions always reach WordPress."
msgstr "Eine kleine PHP-Datei hält pro Abfragezeichenfolge eine Kopie bereit, was für Suchen und Feeds passt. Etwas langsamer als statisches HTML; Formularübermittlungen erreichen immer WordPress."

#: includes/patterns.php:467 includes/patterns.php:766
msgid "Don't cache"
msgstr "Nicht cachen"

#: includes/patterns.php:468
msgid "The pages this pattern applies to are always served live by WordPress. Place it above the patterns it must override."
msgstr "Die Seiten, auf die diese Vorlage zutrifft, werden immer live von WordPress ausgeliefert. Setze sie über die Vorlagen, die sie überschreiben soll."

#: includes/patterns.php:477
msgid "Refresh after"
msgstr "Aktualisieren nach"

#: includes/patterns.php:480
msgid "Seconds a cached page is served before a visit asks for a fresh copy. 86400 is one day."
msgstr "Sekunden, die eine gecachte Seite ausgeliefert wird, bevor ein Besuch eine frische Kopie anfordert. 86400 entspricht einem Tag."

#: includes/patterns.php:484
msgid "Preload refresh after"
msgstr "Vorladen aktualisieren nach"

#: includes/patterns.php:487
msgid "Seconds before the preload rebuilds a cached page. With “Refresh expired pages: from the preload only”, the preload uses “Refresh after” instead."
msgstr "Sekunden, bevor das Vorladen eine gecachte Seite neu aufbaut. Bei „Abgelaufene Seiten aktualisieren: nur durch Vorladen“ verwendet das Vorladen stattdessen „Aktualisieren nach“."

#: includes/patterns.php:747
msgid "Order"
msgstr "Reihenfolge"

#: includes/patterns.php:749
